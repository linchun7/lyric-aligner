+def _forward_resync(
+    cues: Sequence[SubtitleCue],
+    cue_index: int,
+    rows: Sequence[TimedCanonicalOccurrence],
+    row_index: int,
+    model: SequenceProjectionModel,
+    strong_cues: set[int],
+) -> tuple[int, int] | None:
+    """Find a narrow timing-only re-lock after one local frontier break.
+
+    The skipped cue(s) and canonical row(s) remain unresolved.  Re-entry is
+    allowed only when the future cue start and the following canonical boundary
+    both lock tightly to the independent sequence projection.  This prevents a
+    single straddling/garbled cue from poisoning the rest of a song while still
+    refusing to chase canonical order blindly across a cut.
+    """
+
+    for cue_skip in range(1, _FRONTIER_RESYNC_MAX_CUE_SKIP + 1):
+        candidate_cue_index = cue_index + cue_skip
+        if candidate_cue_index >= len(cues):
+            break
+        if any(
+            index in strong_cues
+            for index in range(cue_index, candidate_cue_index + 1)
+        ):
+            break
+        cue = cues[candidate_cue_index]
+        cue_start, _ = _cue_times(cue)
+        next_start: int | None = None
