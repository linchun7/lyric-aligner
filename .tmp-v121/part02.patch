+def _stream_locks(
+    cues: Sequence[SubtitleCue],
+    rows: Sequence[TimedCanonicalOccurrence],
+    decisions_by_cue: Mapping[int, MatchDecision],
+    model: SequenceProjectionModel,
+) -> list[_StreamLock]:
+    positions = {row.ordinal: index for index, row in enumerate(rows)}
+    locks: list[_StreamLock] = []
+    for cue in cues:
+        decision = decisions_by_cue.get(cue.ordinal)
+        if decision is None:
+            continue
+        if decision.action != "review" and decision.canonical_span is not None:
+            start, end = decision.canonical_span
+            if start in positions:
+                start_pos = positions[start]
+                end_pos = positions.get(end - 1, start_pos) + 1
+                if end_pos > start_pos:
