+    # smaller timing residual. Greedy monotonic filtering rejects repeated-line
+    # ambiguity from becoming a stream boundary.
+    by_cue: dict[int, _StreamLock] = {}
+    for item in locks:
+        previous = by_cue.get(item.cue_ordinal)
+        if previous is None or (item.protected, -item.delta_ms) > (
+            previous.protected,
+            -previous.delta_ms,
+        ):
