+    # cues may both look like locks for the same canonical row. Keep the cue
+    # with the strongest identity/tightest timing residual instead of the first
+    # cue in file order.
+    by_row: dict[int, _StreamLock] = {}
+    for item in by_cue.values():
+        previous = by_row.get(item.row_position)
+        if previous is None or (item.protected, -item.delta_ms) > (
+            previous.protected,
+            -previous.delta_ms,
+        ):
+            by_row[item.row_position] = item
