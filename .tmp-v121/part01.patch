+def _snap_stream_split(text: str, position: int, *, radius: int = 8) -> int:
+    """Avoid splitting a Latin token when a nearby whitespace boundary exists."""
+
+    position = max(0, min(len(text), int(position)))
+    if position in {0, len(text)}:
+        return position
+    if text[position - 1].isspace() or text[position].isspace():
+        return position
+    candidates: list[tuple[int, int]] = []
+    for index in range(max(1, position - radius), min(len(text), position + radius) + 1):
+        if text[index - 1].isspace() or (index < len(text) and text[index].isspace()):
+            candidates.append((abs(index - position), index))
+    return min(candidates)[1] if candidates else position
