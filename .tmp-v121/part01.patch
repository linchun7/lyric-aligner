+def _nearest_row_lock(
+    cue: SubtitleCue,
+    rows: Sequence[TimedCanonicalOccurrence],
+    model: SequenceProjectionModel,
+    *,
+    tolerance_ms: int = 600,
+) -> tuple[int, int] | None:
+    cue_start, _ = _cue_times(cue)
+    candidates = sorted(
+        (
+            abs(model.source_to_mix_ms(row.anchor_time_ms) - cue_start),
+            position,
+        )
+        for position, row in enumerate(rows)
+    )
+    if not candidates or candidates[0][0] > tolerance_ms:
+        return None
+    if len(candidates) > 1 and candidates[1][0] - candidates[0][0] < 300:
+        return None
+    return candidates[0][1], int(candidates[0][0])
